APP_NAME=CareerHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=career-hub
DB_USERNAME=root
DB_PASSWORD=

# Comma-separated frontend origins (required in production)
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# Initial admin (php artisan db:seed) — use 12+ chars with mixed case, number, symbol
ADMIN_INITIAL_PASSWORD=

# Sanctum API token lifetime in minutes (default 7 days)
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080

# Google Gemini — server-side only; never expose in the frontend
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=60

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Production checklist:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-api-domain.com
# FRONTEND_URLS=https://your-app-domain.com
# Use strong DB credentials (not root with empty password)
